    @GetMapping("/recherche")
    public String afficherRecherche(
            @RequestParam(required = false) LocalDate dateDebut,
            @RequestParam(required = false) LocalDate dateFin,
            @RequestParam(required = false) String nomProduit,
            @RequestParam(required = false) String categorie,
            @RequestParam(required = false) Double prixMin,
            @RequestParam(required = false) Double prixMax,
            Model model
    ) {
        // Vérifiez si une recherche est déclenchée
        boolean rechercheEffectuee = dateDebut != null || dateFin != null || nomProduit != null || categorie != null || prixMin != null || prixMax != null;

        Produit.CategorieProduit categorieProduitEnum = null;

        // Convertir le paramètre de catégorie en énumération, si nécessaire
        if (categorie != null && !categorie.isEmpty()) {
            try {
                categorieProduitEnum = Produit.CategorieProduit.valueOf(categorie.toUpperCase());
            } catch (IllegalArgumentException e) {
                // Si la conversion échoue, retourner une erreur ou ignorer le filtre
                model.addAttribute("erreurCategorie", "Catégorie invalide : " + categorie);
                model.addAttribute("ventes", Collections.emptyList());
                return "ventes/recherche";
            }
        }

        // Appeler le service avec les paramètres
        List<Vente> ventes = rechercheEffectuee
                ? venteService.rechercheVentesAvancee(dateDebut, dateFin, nomProduit, String.valueOf(categorieProduitEnum), prixMin, prixMax)
                : Collections.emptyList();

        // Ajouter les résultats et l'état au modèle
        model.addAttribute("ventes", ventes);
        model.addAttribute("rechercheEffectuee", rechercheEffectuee);

        return "ventes/recherche";
    }

}

class VenteRequest {
    private List<LigneVente> lignesVente;
    private Long clientId;
    private Long vendeurId;
    private Vente.ModePaiement modePaiement;
    private LocalDateTime dateVente;

    // Getters et setters
    public List<LigneVente> getLignesVente() { return lignesVente; }
    public void setLignesVente(List<LigneVente> lignesVente) { this.lignesVente = lignesVente; }

    public Long getClientId() { return clientId; }
    public void setClientId(Long clientId) { this.clientId = clientId; }

    public Long getVendeurId() { return vendeurId; }
    public void setVendeurId(Long vendeurId) { this.vendeurId = vendeurId; }

    public Vente.ModePaiement getModePaiement() { return modePaiement; }
    public void setModePaiement(Vente.ModePaiement modePaiement) { this.modePaiement = modePaiement; }

    public LocalDateTime getDateVente() { return dateVente; }
    public void setDateVente(LocalDateTime dateVente) { this.dateVente = dateVente; }
}